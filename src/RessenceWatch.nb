Notebook[{
Cell["Ressence Type 1 \[LongDash] ROCS watch in graphics primitives", "Title",ExpressionUUID->"e732860b-68c3-124b-a695-829fe339d05a"],

Cell[TextData[{
 "The main disc is a planet carrier that turns once an hour; the long marker \
on it reads the minutes against the fixed outer scale. The hour, seconds and \
day-of-week dials are drawn with graphics primitives and ",
 Cell[BoxData[
  TemplateBox[{
   "Text", "paclet:ref/Text", 
    "https://reference.wolfram.com/language/ref/Text.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "2a0dc445-cdf0-b244-91e7-614cf32a5639"],
 ". They orbit with the carrier but are counter-geared so they never spin: \
their numerals and ticks stay upright, and only the hands inside turn. "
}], "Text",ExpressionUUID->"1a650cbb-2806-4e41-80b0-4ab2a9581734"],

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], 
     ",", "\"\<RessenceWatch.wl\>\""}], "}"}], "]"}], "]"}]], "Input",Expressi\
onUUID->"498d9727-89b4-4540-8e69-b6720c74eca1"],

Cell["Live watch", "Section",ExpressionUUID->"09baf57c-352e-9449-8661-0c04a96ff22d"],

Cell[TextData[{
 "Set ",
 StyleBox["Time warp",
  FontWeight->Bold],
 " to 100\[Times] or 250\[Times] to watch the satellites orbit. "
}], "Text",ExpressionUUID->"9690aca4-8ccd-fe48-baf0-da9a1c5bc635"],

Cell[BoxData[
 RowBox[{"RessenceWatch", "[", "]"}]], "Input",ExpressionUUID->"399e3697-cf74-c541-a38f-3f027c374d2a"],

Cell["A single frame", "Section",ExpressionUUID->"56d76a68-ee07-0943-8cb2-bce2fffc8c3d"],

Cell[BoxData[
 RowBox[{"RessenceWatchFace", "[", 
  RowBox[{"DateObject", "[",
   RowBox[{"{",
    RowBox[{"2026", ",", "10", ",", "14", ",", "10", ",", "10", ",", "47"}], "}"}], "]"}], "]"}]], "Input",Ex\
pressionUUID->"bb792a22-bdb4-d244-a3ee-2ef0f69d1b4a"],

Cell["Animation (one hour compressed)", "Section",ExpressionUUID->"c048e7ed-2a6d-6247-9460-dea0ef6d0e30"],

Cell[BoxData[
 RowBox[{"ListAnimate", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"RessenceWatchFace", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DateObject", "[",
        RowBox[{"{",
         RowBox[{"2026", ",", "10", ",", "14", ",", "10", ",", "0", ",", "0"}], "}"}], "]"}], "+",
       RowBox[{"Quantity", "[",
        RowBox[{
         RowBox[{"50", " ", "k"}], ",", "\"\<Seconds\>\""}], "]"}]}], ",",
      RowBox[{"ImageSize", "->", "360"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", "71"}], "}"}]}], "]"}], "]"}]], "Input",Expre\
ssionUUID->"927de2cc-eab4-0244-84c4-e263d2a6e048"]
},
